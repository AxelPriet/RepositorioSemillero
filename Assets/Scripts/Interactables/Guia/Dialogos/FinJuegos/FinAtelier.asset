  m_Script: {fileID: 11500000, guid: 6da3e976eb65e6c489143298166f6e22, type: 3}
  m_Name: FinAtelier
  m_EditorClassIdentifier: Assembly-CSharp::GuideDialogueSO
  dialogueID: FinAtelier
  lines:
  - "\xA1El robot ha vuelto a la vida pieza por pieza! Un trabajo de precisi\xF3n
    y paciencia. Ahora dir\xEDgete al edificio cuatro. El anfiteatro te espera con
    su rompecabezas anat\xF3mico, y m\xE1s arriba, otro laboratorio donde cada espacio
    cuenta. El camino sigue abierto si aun no los has hecho."
  mostrarUnaVez: 1
