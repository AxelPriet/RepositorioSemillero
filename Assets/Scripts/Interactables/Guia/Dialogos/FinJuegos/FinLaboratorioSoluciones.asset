  m_Script: {fileID: 11500000, guid: 6da3e976eb65e6c489143298166f6e22, type: 3}
  m_Name: FinLaboratorioSoluciones
  m_EditorClassIdentifier: Assembly-CSharp::GuideDialogueSO
  dialogueID: FinLaboratorioSoluciones
  lines:
  - "\xA1Medidas perfectas! Ahora cruza hacia el edificio cuatro. El anfiteatro est\xE1
    ah\xED, con sus \xF3rganos por ordenar. Y dos pisos m\xE1s arriba, otro laboratorio
    te reta a llenar cada espacio."
