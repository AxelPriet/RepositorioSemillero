  m_Script: {fileID: 11500000, guid: 6da3e976eb65e6c489143298166f6e22, type: 3}
  m_Name: FinCroma
  m_EditorClassIdentifier: Assembly-CSharp::GuideDialogueSO
  dialogueID: FinCroma
  lines:
  - "\xA1Bien capturado! Si bajas m\xE1s, el aula magna te espera con una ceremonia
    especial. Y si prefieres el deporte... la cancha de b\xE1squet est\xE1 en el
    piso superior en el coliseo. T\xFA eliges."
  mostrarUnaVez: 1
