  m_Script: {fileID: 11500000, guid: 6da3e976eb65e6c489143298166f6e22, type: 3}
  m_Name: ExplicacionClinica
  m_EditorClassIdentifier: Assembly-CSharp::GuideDialogueSO
  dialogueID: ExplicacionClinica
  lines:
  - "Este es el simulador de RCP. Mira esa barra... sube y baja como un latido. Tu
    misi\xF3n es simple pero precisa: presiona ESPACIO justo cuando el indicador
    est\xE9 en verde. Hazlo cinco veces sin fallar tres. \xBFSer\xE1s capaz de mantener
    el ritmo?"
  mostrarUnaVez: 1
