  m_Script: {fileID: 11500000, guid: 6da3e976eb65e6c489143298166f6e22, type: 3}
  m_Name: ExplicacionFisioterapia
  m_EditorClassIdentifier: Assembly-CSharp::GuideDialogueSO
  dialogueID: ExplicacionFisioterapia
  lines:
  - "Agua que necesita el equilibrio perfecto. Usa A y D para abrir las llaves. Si
    abres las dos, la temperatura se estabiliza. Mant\xE9n la tina entre 40 y 60
    grados durante cinco segundos. Ni fr\xEDo, ni caliente... justo como debe ser."
  mostrarUnaVez: 1
